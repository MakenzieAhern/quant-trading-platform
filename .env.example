# Copy to .env for host-based development. Docker Compose supplies container URLs.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://quant:quant_dev_only@localhost:5432/quant_platform
REDIS_URL=redis://localhost:6379/0
BROKER_MODE=paper
MARKET_DATA_PROVIDER=csv
MARKET_DATA_PATH=data/raw
FRONTEND_ORIGIN=http://localhost:5173

BACKTEST_FIXTURE_PATH=data/fixtures
# Public browser URL; never put credentials in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8000
