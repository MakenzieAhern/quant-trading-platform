# Copy to .env for host-based development. Docker Compose supplies container URLs.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://quant:quant_dev_only@localhost:5432/quant_platform
REDIS_URL=redis://localhost:6379/0
BROKER_MODE=paper
MARKET_DATA_PROVIDER=csv
MARKET_DATA_PATH=data/raw
FRONTEND_ORIGIN=http://localhost:5173

# Future integrations: placeholders only; never commit real credentials.
ALPACA_API_KEY=
ALPACA_SECRET=
IBKR_HOST=
IBKR_PORT=
BINANCE_API_KEY=
BINANCE_SECRET=
